<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg_light"
    tools:context=".activities.HomeActivity">

    <!-- Header: Dark Teal Bar with Title and Profile Icon -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/home_header_background"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/login_title"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/iconProfile"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_profile_home"
            android:contentDescription="@string/nav_profile"
            android:tint="@color/white"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Location Filter Buttons -->
    <LinearLayout
        android:id="@+id/filterGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/headerBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/buttonFilterState"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="@string/filter_state"
            android:textColor="@color/home_text_dark"
            android:textSize="12sp"
            android:background="@drawable/home_filter_button"
            android:drawableEnd="@drawable/ic_chevron_down"
            android:drawablePadding="4dp"
            android:drawableTint="@color/home_text_secondary"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <Button
            android:id="@+id/buttonFilterDistrict"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="@string/filter_district"
            android:textColor="@color/home_text_dark"
            android:textSize="12sp"
            android:background="@drawable/home_filter_button"
            android:drawableEnd="@drawable/ic_chevron_down"
            android:drawablePadding="4dp"
            android:drawableTint="@color/home_text_secondary"
            android:gravity="center"
            android:layout_marginStart="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <Button
            android:id="@+id/buttonFilterMandal"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="@string/filter_mandal"
            android:textColor="@color/home_text_dark"
            android:textSize="12sp"
            android:background="@drawable/home_filter_button"
            android:drawableEnd="@drawable/ic_chevron_down"
            android:drawablePadding="4dp"
            android:drawableTint="@color/home_text_secondary"
            android:gravity="center"
            android:layout_marginStart="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <Button
            android:id="@+id/buttonFilterVillage"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="@string/filter_village"
            android:textColor="@color/home_text_dark"
            android:textSize="12sp"
            android:background="@drawable/home_filter_button"
            android:drawableEnd="@drawable/ic_chevron_down"
            android:drawablePadding="4dp"
            android:drawableTint="@color/home_text_secondary"
            android:gravity="center"
            android:layout_marginStart="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

    </LinearLayout>

    <!-- Content Creation Area -->
    <FrameLayout
        android:id="@+id/frameCreatePost"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/home_input_background"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:minHeight="56dp"
        app:layout_constraintTop_toBottomOf="@id/filterGroup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/editPostInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_whats_happening"
            android:inputType="textMultiLine"
            android:textColor="@color/home_text_dark"
            android:textColorHint="@color/home_text_secondary"
            android:textSize="14sp"
            android:padding="16dp"
            android:background="@android:color/transparent"
            android:minHeight="56dp"
            android:maxLines="3"
            android:gravity="top|start"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="true" />

    </FrameLayout>

    <!-- Action Icons and POST Button -->
    <LinearLayout
        android:id="@+id/layoutPostActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/frameCreatePost"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/buttonTextImage"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_text_image"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Text/Image"
            android:padding="4dp" />

        <ImageButton
            android:id="@+id/buttonVideo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_video_camera"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Video"
            android:layout_marginStart="8dp"
            android:padding="4dp" />

        <ImageButton
            android:id="@+id/buttonAudio"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_microphone"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Audio"
            android:layout_marginStart="8dp"
            android:padding="4dp" />

        <Button
            android:id="@+id/buttonPost"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/action_post"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:background="@drawable/home_post_button"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginStart="16dp"
            android:layout_gravity="end" />

    </LinearLayout>

    <!-- Posts RecyclerView -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/layoutPostActions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/adContainer">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPosts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp"
            android:background="@color/home_bg_light"
            tools:listitem="@layout/item_post" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <FrameLayout
        android:id="@+id/adContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="56dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:menu="@menu/menu_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>
