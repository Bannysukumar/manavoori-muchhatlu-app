<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Region Management"
        android:textColor="@color/admin_text_white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- Add State Section -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/admin_card_frosted_blue"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add State"
                android:textColor="@color/admin_text_white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="State Name"
                app:hintTextColor="@color/admin_text_white"
                app:boxBackgroundMode="filled"
                app:boxBackgroundColor="#40FFFFFF"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputStateName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/admin_text_white"
                    android:textColorHint="#B3FFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/buttonAddState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add State"
                android:textColor="@color/admin_text_white"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delete State"
                android:textColor="@color/admin_text_white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select State to Delete"
                app:hintTextColor="@color/admin_text_white"
                app:boxBackgroundMode="filled"
                app:boxBackgroundColor="#40FFFFFF"
                android:layout_marginBottom="12dp">

                <Spinner
                    android:id="@+id/spinnerDeleteState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/buttonDeleteState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delete State"
                android:textColor="@android:color/white"
                android:backgroundTint="#D32F2F"
                style="@style/Widget.Material3.Button" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Add District Section -->
    <com.google.android.material.card.MaterialCardView
