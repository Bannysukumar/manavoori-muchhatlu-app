                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add District"
                android:textColor="@color/admin_text_white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select State"
                app:hintTextColor="@color/admin_text_white"
                app:boxBackgroundMode="filled"
                app:boxBackgroundColor="#40FFFFFF"
                android:layout_marginBottom="12dp">

                <Spinner
                    android:id="@+id/spinnerStateForDistrict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="District Name"
                app:hintTextColor="@color/admin_text_white"
                app:boxBackgroundMode="filled"
                app:boxBackgroundColor="#40FFFFFF"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputDistrictName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/admin_text_white"
                    android:textColorHint="#B3FFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/buttonAddDistrict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add District"
                android:textColor="@color/admin_text_white"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delete District"
                android:textColor="@color/admin_text_white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select State"
                app:hintTextColor="@color/admin_text_white"
                app:boxBackgroundMode="filled"
                app:boxBackgroundColor="#40FFFFFF"
                android:layout_marginBottom="12dp">

                <Spinner
                    android:id="@+id/spinnerStateForDeleteDistrict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select District to Delete"
                app:hintTextColor="@color/admin_text_white"
                app:boxBackgroundMode="filled"
                app:boxBackgroundColor="#40FFFFFF"
                android:layout_marginBottom="12dp">

                <Spinner
                    android:id="@+id/spinnerDeleteDistrict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/buttonDeleteDistrict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delete District"
                android:textColor="@android:color/white"
                android:backgroundTint="#D32F2F"
                style="@style/Widget.Material3.Button" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

