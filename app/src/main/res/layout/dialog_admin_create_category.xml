<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Category Name -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutName"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_category_name"
        android:layout_marginBottom="16dp"
        app:boxStrokeColor="@color/splash_outline"
        app:hintTextColor="@color/admin_text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/admin_text_white"
            android:textColorHint="@color/admin_text_secondary"
            android:inputType="text"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Description -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutDescription"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_category_description"
        android:layout_marginBottom="16dp"
        app:boxStrokeColor="@color/splash_outline"
        app:hintTextColor="@color/admin_text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/admin_text_white"
            android:textColorHint="@color/admin_text_secondary"
            android:inputType="textMultiLine"
            android:maxLines="3" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Priority -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutPriority"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_category_priority"
        android:layout_marginBottom="16dp"
        app:boxStrokeColor="@color/splash_outline"
        app:hintTextColor="@color/admin_text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputPriority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/admin_text_white"
            android:textColorHint="@color/admin_text_secondary"
            android:inputType="number"
            android:maxLines="1"
            android:text="50" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Enabled Switch -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchEnabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_category_enabled"
        android:textColor="@color/admin_text_white"
        android:checked="true"
        app:thumbTint="@color/admin_card_green_border"
        app:trackTint="@color/admin_card_green_border" />

    <!-- Category Editor (optional) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutEditor"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/label_category_editor"
        android:layout_marginTop="16dp"
        app:boxStrokeColor="@color/splash_outline"
        app:hintTextColor="@color/admin_text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputEditor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/admin_text_white"
            android:textColorHint="@color/admin_text_secondary"
            android:inputType="text"
            android:maxLines="1"
            android:hint="Select user (optional)" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>

