<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.Muchhatlu.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="titleTextColor">@color/md_theme_light_onSurface</item>
        <item name="subtitleTextColor">@color/splash_text_secondary</item>
        <item name="android:elevation">0dp</item>
        <item name="titleCentered">true</item>
    </style>

    <style name="Widget.Muchhatlu.Button" parent="Widget.Material3.Button">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="backgroundTint">@color/md_theme_light_primary</item>
        <item name="android:textColor">@color/md_theme_light_onPrimary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Muchhatlu.Pill</item>
    </style>

    <style name="Widget.Muchhatlu.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="strokeColor">@color/md_theme_light_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/md_theme_light_onSurface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Muchhatlu.Pill</item>
    </style>

    <style name="Widget.Muchhatlu.CardView" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/splash_card_bg</item>
        <item name="strokeColor">@color/splash_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Muchhatlu.Medium</item>
    </style>

    <style name="Widget.Muchhatlu.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <item name="boxBackgroundColor">@color/md_theme_light_surfaceVariant</item>
        <item name="boxStrokeColor">@color/md_theme_light_outline</item>
        <item name="android:textColorHint">@color/splash_text_secondary</item>
        <item name="android:textColor">@color/md_theme_light_onSurface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Muchhatlu.Medium</item>
    </style>

    <style name="Widget.Muchhatlu.Fab" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/md_theme_light_secondary</item>
        <item name="android:tint">@color/md_theme_light_onSecondary</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Muchhatlu.Pill</item>
    </style>

    <style name="Widget.Muchhatlu.Progress" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorColor">@color/md_theme_light_secondary</item>
        <item name="trackColor">@color/splash_text_secondary</item>
    </style>

    <style name="ShapeAppearance.Muchhatlu.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.Muchhatlu.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.Muchhatlu.PostImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

</resources>


